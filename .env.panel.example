# Copy to .env.panel and fill real values.

DATABASE_URL=postgresql://user:password@postgres:5432/minecraft_panel
BOT_TOKEN=123456789:replace_me
WEB_APP_URL=https://example.com
PANEL_DOMAIN=example.com

# The RCON password must match the existing Minecraft .env value.
RCON_PASSWORD=change-me-before-start
RCON_PORT=25575
MINECRAFT_DATA_PATH=/minecraft-data

PANEL_API_PORT=8000
PANEL_WEB_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443
VITE_API_BASE_URL=/api

# Comma-separated HTTPS origins in production. Use * only while testing.
CORS_ORIGINS=*
INIT_DATA_MAX_AGE_SECONDS=86400
