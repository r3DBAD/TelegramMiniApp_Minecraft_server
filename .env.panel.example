# Copy this file to .env.panel and fill real secrets.
#
# Production domain:
#   https://panel.r3dbad.ru
#
# Local cloudflared test:
#   WEB_APP_URL=https://your-temporary-name.trycloudflare.com
#   CORS_ORIGINS=https://your-temporary-name.trycloudflare.com

# Postgres
# If Postgres is another Docker service in the same compose network:
# DATABASE_URL=postgresql://user:password@postgres:5432/minecraft_panel
#
# If Postgres runs on the host/server, use an address reachable from containers.
# On Linux Docker, 127.0.0.1 means "inside the panel-api container", not the host.
DATABASE_URL=postgresql://user:password@postgres:5432/minecraft_panel

# Telegram
BOT_TOKEN=123456789:replace_me
WEB_APP_URL=https://panel.r3dbad.ru

# HTTPS reverse proxy
PANEL_DOMAIN=panel.r3dbad.ru
HTTP_PORT=80
HTTPS_PORT=443

# Minecraft RCON
# In Docker compose production, use the minecraft service name.
# For local uvicorn + SSH tunnel, use RCON_HOST=127.0.0.1.
RCON_HOST=minecraft
RCON_PORT=25575
RCON_PASSWORD=replace_with_current_minecraft_rcon_password

# Read-only mount from ./data in docker-compose.panel.yml.
MINECRAFT_DATA_PATH=/minecraft-data

# Panel ports exposed on the host. Caddy proxies to panel-web internally.
PANEL_API_PORT=8000
PANEL_WEB_PORT=8080

# Frontend uses /api because panel-web nginx proxies /api/* to panel-api.
VITE_API_BASE_URL=/api

# Security
# In production keep this exact HTTPS origin. Use * only for temporary local tests.
CORS_ORIGINS=https://panel.r3dbad.ru
INIT_DATA_MAX_AGE_SECONDS=900
API_RATE_LIMIT_REQUESTS=120
API_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
